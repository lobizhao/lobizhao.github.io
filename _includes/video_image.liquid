<div class="media-container {{class}}">
    <figure>
        <div>
            <video class="zoomable" preload="none" poster="/assets/video/{{ src }}_poster.webp" muted loop playsinline>
                <source src="/assets/video/{{ src }}.webm" type="video/webm">
                <source src="/assets/video/{{ src }}.mp4" type="video/mp4">
            </video><img class="loading" src="/assets/image/loading.webp" />
        </div>
        <figcaption>{{ caption }}</figcaption>
    </figure>
</div>
